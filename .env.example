# Resend (https://resend.com) API key — used by /api/contact to email form submissions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=everlovehomecarellc@gmail.com

# Sender address (the display name is set per email). onboarding@resend.dev only
# delivers to the Resend account owner's own inbox, so once everlovehomecarellc.com is
# verified in Resend switch to e.g. "EverLove Homecare <hello@everlovehomecarellc.com>".
CONTACT_FROM_EMAIL="EverLove Homecare <onboarding@resend.dev>"
