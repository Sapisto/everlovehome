---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import logoWhite from "@/assets/brand/logo-full-white.png";
import { nav, site } from "@/lib/site";

const services = (await getCollection("services", (s) => s.data.inGrid)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const socials = (
  [
    ["Facebook", site.social.facebook],
    ["Instagram", site.social.instagram],
    ["LinkedIn", site.social.linkedin],
  ] as const
).filter(([, url]) => url !== "");
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <Image class="footer__logo" src={logoWhite} alt={site.name} width={190} densities={[1, 2]} />
      {
        socials.length > 0 && (
          <ul class="footer__social">
            {socials.map(([label, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener">{label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <nav class="footer__col" aria-label="Footer">
      <h4>Explore</h4>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="footer__col">
      <h4>Services</h4>
      {services.map((s) => <a href="/#services">{s.data.title}</a>)}
    </div>
    <div class="footer__col">
      <h4>Get in touch</h4>
      <a href={site.phone.href}><Icon name="phone" /> {site.phone.international}</a>
      <a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      <a href={site.url}><Icon name="globe" /> {site.domain}</a>
      <p class="footer__always">{site.availability}</p>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.legalName}. All rights reserved.</p>
    <p><a href="/privacy">Privacy Policy</a> · <a href="#top">Back to top ↑</a></p>
  </div>
</footer>

<div class="mobile-bar">
  <a href={site.phone.href} class="mobile-bar__call"><Icon name="phone" /> Call Now</a>
  <a href="/#contact" class="mobile-bar__book"><Icon name="calendar" /> Free Consultation</a>
</div>

<style>
  .footer { background: var(--plum-950); color: rgb(255 255 255 / 0.72); padding-top: clamp(56px, 8vw, 88px); }
  .footer__grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1.3fr; gap: 40px; padding-bottom: 48px; }
  .footer :global(.footer__logo) { width: 190px; height: auto; }
  .footer__social { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .footer__social a { display: inline-block; padding: 6px 14px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.2); text-decoration: none; font-size: 0.85rem; }
  .footer__social a:hover { background: rgb(255 255 255 / 0.1); color: #fff; }
  .footer__col { display: grid; align-content: start; gap: 10px; }
  .footer h4 { font-family: var(--font-display); color: #fff; font-weight: 600; font-size: 1.15rem; margin-bottom: 8px; }
  .footer__col a { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 0.95rem; transition: color 0.2s; overflow-wrap: anywhere; }
  .footer__col a:hover { color: #fff; }
  .footer__col :global(.ic) { color: var(--gold); }
  .footer__always { color: var(--gold); font-weight: 700; margin-top: 6px; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 24px; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.86rem; }
  .footer__bottom a { text-decoration: none; }
  .footer__bottom a:hover { color: #fff; }

  .mobile-bar { display: none; }

  @media (max-width: 980px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .footer__grid { grid-template-columns: 1fr; }
    .mobile-bar {
      display: grid; grid-template-columns: 1fr 1.3fr; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgb(255 255 255 / 0.96);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--line);
      box-shadow: 0 -10px 30px -16px rgb(42 15 63 / 0.3);
    }
    .mobile-bar a { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border-radius: 14px; font-weight: 700; text-decoration: none; }
    .mobile-bar__call { background: var(--lilac-100); color: var(--plum-800); }
    .mobile-bar__book { background: linear-gradient(135deg, var(--brand), var(--plum-800)); color: #fff; }
  }
</style>
