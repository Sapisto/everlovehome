---
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import type { IconName } from "@/lib/icons";

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: "shield", title: "Trusted caregivers", text: "Carefully screened, background-checked and chosen for their compassion as much as their skill." },
  { icon: "clipboard", title: "Personalized care plans", text: "Built around your loved one's routines, preferences and personality, never one-size-fits-all." },
  { icon: "clock", title: "Here when you need us", text: "A few hours a week, daily visits, overnights or around-the-clock. Care that flexes with life." },
  { icon: "users", title: "Family stays in the loop", text: "Regular updates and open communication, so you always know how your loved one is doing." },
];
---

<section class="section about" id="about">
  <div class="container about__grid">
    <div class="about__visual reveal">
      <Photo name="about" variant="blob" alt="Caregiver and client smiling together over a cup of tea" />
      <div class="about__badge" aria-hidden="true">
        <span class="script">Ever loving.</span>
        <span class="script">Ever present.</span>
      </div>
    </div>
    <div>
      <h2 class="section-title reveal">Your loved one deserves to be cared for like <em>family</em>.</h2>
      <p class="lead reveal">
        At EverLove Homecare, we believe the best care happens where life is most familiar: at home. We pair every client
        with a caregiver who brings patience, dignity and a genuine love for helping others, so families can breathe easier.
      </p>
      <div class="features">
        {features.map((f) => (
          <article class="feature reveal">
            <span class="feature__icon"><Icon name={f.icon} /></span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(48px, 7vw, 96px); align-items: center; }
  .about__visual { position: relative; max-width: 500px; width: 100%; }
  .about__badge {
    position: absolute; right: -8px; bottom: 6%; z-index: 3; display: grid; padding: 18px 26px;
    border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); transform: rotate(-4deg);
  }
  .about__badge .script { font-size: 2.1rem; }
  .about__badge .script + .script { color: var(--gold-600); margin-left: 24px; }
  .features { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; margin-top: 40px; }
  .feature { display: flex; gap: 16px; align-items: flex-start; }
  .feature__icon {
    width: 54px; height: 54px; flex-shrink: 0; display: grid; place-items: center; border-radius: 16px; color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--plum-900)); box-shadow: 0 10px 20px -10px rgb(79 26 116 / 0.8);
  }
  .feature__icon :global(.ic) { width: 24px; height: 24px; }
  .feature h3 { font-size: 1.08rem; font-weight: 700; color: var(--plum-900); margin-bottom: 4px; }
  .feature p { font-size: 0.96rem; color: var(--muted); }

  @media (max-width: 980px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__visual { margin-inline: auto; max-width: 420px; }
  }
  @media (max-width: 640px) {
    .features { grid-template-columns: 1fr; }
    .about__badge .script { font-size: 1.7rem; }
  }
</style>
