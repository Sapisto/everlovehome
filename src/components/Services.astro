---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "@/lib/site";

const services = (await getCollection("services", (s) => s.data.inGrid)).sort((a, b) => a.data.order - b.data.order);
---

<section class="section services" id="services">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">Care that fits <em>their</em> life</h2>
      <p class="lead">Thoughtful, non-medical support for everyday living, tailored to exactly what your loved one needs.</p>
    </header>

    <div class="service-grid">
      {services.map((s) => (
        <article class="service reveal">
          <span class="service__icon"><Icon name={s.data.icon} /></span>
          <h3>{s.data.title}</h3>
          <p>{s.data.summary}</p>
          <a class="service__link" href="#contact" data-service={s.data.title}>
            Ask about this <Icon name="arrow" />
          </a>
        </article>
      ))}
    </div>

    <div class="areas reveal" id="areas">
      <div class="areas__head">
        <h3>Where we provide care</h3>
        <p>We serve families in these {site.state.name} counties across {site.region}.</p>
      </div>
      <ul class="areas__list" aria-label="Counties we serve">
        {site.serviceAreas.map((county) => <li><Icon name="home" /> {county} County</li>)}
      </ul>
      <p class="areas__note">Not sure if we cover your area? <a href={site.phone.href}>Call {site.phone.display}</a> and we'll let you know.</p>
    </div>
  </div>
</section>

<style>
  .services { background: linear-gradient(180deg, var(--lilac-50), var(--lilac-100)); }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .service {
    position: relative; padding: 34px 30px 30px; border-radius: var(--radius-lg); background: #fff;
    border: 1px solid var(--line); box-shadow: var(--shadow-sm); overflow: hidden;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s;
  }
  .service::before {
    content: ""; position: absolute; inset: 0; z-index: 0; opacity: 0;
    background: linear-gradient(160deg, var(--brand), var(--plum-900)); transition: opacity 0.4s var(--ease);
  }
  .service > * { position: relative; z-index: 1; }
  .service__icon {
    width: 68px; height: 68px; display: grid; place-items: center; border-radius: 22px; margin-bottom: 22px;
    background: var(--lilac-100); color: var(--brand); transition: background 0.4s, color 0.4s, transform 0.4s var(--ease);
  }
  .service__icon :global(.ic) { width: 30px; height: 30px; stroke-width: 1.7; }
  .service h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.45rem; color: var(--plum-900); margin-bottom: 10px; transition: color 0.4s; }
  .service p { color: var(--muted); transition: color 0.4s; }
  .service__link {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; font-weight: 700; font-size: 0.93rem;
    color: var(--brand); text-decoration: none; transition: color 0.4s, gap 0.3s;
  }
  .service:hover, .service:focus-within { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .service:hover::before, .service:focus-within::before { opacity: 1; }
  .service:hover .service__icon, .service:focus-within .service__icon { background: rgb(255 255 255 / 0.14); color: var(--gold-100); transform: rotate(-6deg) scale(1.05); }
  .service:hover h3, .service:focus-within h3 { color: #fff; }
  .service:hover p, .service:focus-within p { color: rgb(255 255 255 / 0.8); }
  .service:hover .service__link, .service:focus-within .service__link { color: var(--gold-100); gap: 12px; }

  .areas {
    margin-top: clamp(48px, 7vw, 72px); padding: clamp(26px, 4vw, 40px); border-radius: var(--radius-lg);
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); scroll-margin-top: 110px;
  }
  .areas__head h3 { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); color: var(--plum-900); }
  .areas__head p { color: var(--muted); margin-top: 6px; }
  .areas__list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .areas__list li {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px;
    background: var(--lilac-50); border: 1px solid var(--line); font-weight: 600; color: var(--plum-800); font-size: 0.95rem;
  }
  .areas__list :global(.ic) { width: 16px; height: 16px; color: var(--brand); }
  .areas__note { margin-top: 20px; font-size: 0.95rem; color: var(--muted); }
  .areas__note a { color: var(--brand); font-weight: 700; }

  @media (max-width: 980px) { .service-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .service-grid { grid-template-columns: 1fr; } }
</style>
