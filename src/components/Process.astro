---
import Icon from "./Icon.astro";
import type { IconName } from "@/lib/icons";

const steps: { icon: IconName; title: string; text: string }[] = [
  { icon: "phone", title: "Reach out", text: "Call or send us a message. Tell us about your loved one and what's on your mind." },
  { icon: "message", title: "Free consultation", text: "We'll meet with you to understand needs, routines, preferences and goals." },
  { icon: "clipboard", title: "Your care plan", text: "We create a personalized plan and thoughtfully match the right caregiver." },
  { icon: "home", title: "Care begins", text: "Your caregiver arrives, and we keep checking in to make sure everything feels right." },
];
---

<section class="section" id="process">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">Getting started is <em>simple</em></h2>
      <p class="lead">From your first call to your first visit, we walk with you every step of the way.</p>
    </header>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step reveal">
          <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="step__icon"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; position: relative; }
  .steps::before {
    content: ""; position: absolute; top: 58px; left: 12%; right: 12%; height: 2px;
    background: repeating-linear-gradient(90deg, var(--lilac-300) 0 10px, transparent 10px 18px);
  }
  .step { position: relative; text-align: center; padding: 0 8px; }
  .step__icon {
    position: relative; width: 116px; height: 116px; margin: 0 auto 24px; border-radius: 50%;
    display: grid; place-items: center; background: #fff; color: var(--brand);
    box-shadow: var(--shadow), inset 0 0 0 10px var(--lilac-100);
    transition: transform 0.4s var(--ease), background 0.4s, color 0.4s;
  }
  .step:hover .step__icon { transform: translateY(-6px); background: var(--brand); color: #fff; }
  .step__icon :global(.ic) { width: 34px; height: 34px; stroke-width: 1.7; }
  .step__num {
    position: absolute; top: -6px; left: 50%; margin-left: 30px; z-index: 2;
    background: var(--gold); color: #fff; font-weight: 800; font-size: 0.8rem; padding: 4px 10px; border-radius: 999px;
  }
  .step h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.4rem; color: var(--plum-900); margin-bottom: 8px; }
  .step p { color: var(--muted); font-size: 0.98rem; }

  @media (max-width: 980px) {
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 48px; }
    .steps::before { display: none; }
  }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; } }
</style>
