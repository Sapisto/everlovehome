---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import markWhite from "@/assets/brand/logo-mark-white.png";
import { site } from "@/lib/site";
---

<section class="cta-band">
  <Image class="cta-band__mark" src={markWhite} alt="" aria-hidden="true" width={420} />
  <div class="container cta-band__inner reveal">
    <div>
      <p class="script cta-band__script">we're here for you</p>
      <h2>Let's find the right care for the one you love.</h2>
      <p class="cta-band__text">Speak with our care team today. The conversation is free, and so is the peace of mind.</p>
    </div>
    <div class="cta-band__actions">
      <a class="cta-band__phone" href={site.phone.href}>
        <span class="cta-band__phone-icon"><Icon name="phone" /></span>
        <span><small>Call us anytime</small>{site.phone.international}</span>
      </a>
      <a class="btn btn--gold btn--lg" href="#contact"><Icon name="calendar" /> Schedule a Consultation</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative; overflow: hidden; color: #fff; padding-block: clamp(56px, 8vw, 96px);
    background: linear-gradient(120deg, var(--plum-900), var(--plum-700) 60%, var(--brand));
  }
  .cta-band :global(.cta-band__mark) {
    position: absolute; left: -60px; top: 50%; width: 420px; transform: translateY(-50%) rotate(-8deg);
    opacity: 0.08; pointer-events: none;
  }
  .cta-band__inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .cta-band__script { color: var(--gold-100); font-size: 2.4rem; }
  .cta-band h2 {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3rem);
    letter-spacing: -0.015em; max-width: 16ch; margin-top: 4px;
  }
  .cta-band__text { color: rgb(255 255 255 / 0.78); margin-top: 14px; max-width: 46ch; }
  .cta-band__actions { display: grid; gap: 16px; flex-shrink: 0; }
  .cta-band__phone {
    display: flex; align-items: center; gap: 16px; text-decoration: none; color: #fff;
    font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 600;
    padding: 14px 26px 14px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.2); transition: background 0.25s;
  }
  .cta-band__phone:hover { background: rgb(255 255 255 / 0.18); }
  .cta-band__phone small { display: block; font-family: var(--font-body); font-size: 0.78rem; font-weight: 500; color: rgb(255 255 255 / 0.7); letter-spacing: 0.05em; }
  .cta-band__phone-icon { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--plum-700); flex-shrink: 0; }
  .cta-band__phone-icon :global(.ic) { width: 26px; height: 26px; animation: ring 3s ease-in-out infinite; }
  @keyframes ring {
    0%, 70%, 100% { transform: rotate(0); }
    75% { transform: rotate(-14deg); } 80% { transform: rotate(12deg); }
    85% { transform: rotate(-8deg); } 90% { transform: rotate(6deg); }
  }

  @media (max-width: 980px) { .cta-band__inner { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { .cta-band__actions, .cta-band__phone { width: 100%; } }
</style>
