---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "@/lib/site";

const faqs = (await getCollection("faqs")).sort((a, b) => a.data.order - b.data.order);
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.data.question,
    acceptedAnswer: { "@type": "Answer", text: f.data.answer },
  })),
};
---

<section class="section faq" id="faq">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <div class="container faq__grid">
    <header class="faq__head reveal">
      <h2 class="section-title">Frequently asked <em>questions</em></h2>
      <p class="lead">Don't see your question? We're always happy to talk it through.</p>
      <a class="btn btn--ghost" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
    </header>
    <div class="accordion reveal">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>
            {f.data.question}
            <Icon name="plus" />
          </summary>
          <p>{f.data.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: #fff; }
  .faq__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  .faq__head { position: sticky; top: 120px; }
  .faq__head .btn { margin-top: 28px; }
  .accordion { display: grid; gap: 14px; }
  details { border: 1px solid var(--line); border-radius: var(--radius); background: var(--lilac-50); transition: background 0.3s, border-color 0.3s, box-shadow 0.3s; }
  details[open] { background: #fff; border-color: var(--lilac-300); box-shadow: var(--shadow-sm); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 22px 24px; font-weight: 600; font-size: 1.06rem; color: var(--plum-900);
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(.ic) {
    width: 34px; height: 34px; padding: 8px; border-radius: 50%; background: var(--lilac-100); color: var(--brand);
    transition: transform 0.3s var(--ease), background 0.3s, color 0.3s;
  }
  details[open] summary :global(.ic) { transform: rotate(45deg); background: var(--brand); color: #fff; }
  details p { padding: 0 24px 24px; color: var(--muted); max-width: 62ch; }

  @media (max-width: 980px) {
    .faq__grid { grid-template-columns: 1fr; }
    .faq__head { position: static; }
  }
</style>
