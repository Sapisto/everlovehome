---
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { mailto, site } from "@/lib/site";

const perks = [
  "Flexible schedules that fit your life",
  "Meaningful work close to home",
  "A supportive team that has your back",
  "Respect, appreciation and room to grow",
];
const applyHref = mailto(
  "Caregiver Application",
  "Hi EverLove team,\n\nI'd love to apply as a caregiver.\n\nName:\nPhone:\nExperience:\nAvailability:\n",
);
---

<section class="section careers" id="careers">
  <div class="container">
    <div class="careers__card reveal">
      <div>
        <h2 class="section-title">Have a heart for caring? <em>Join the EverLove family.</em></h2>
        <p class="lead">We're always looking for compassionate caregivers who want work that truly matters.</p>
        <ul class="checklist">
          {perks.map((p) => <li><Icon name="check" /> {p}</li>)}
        </ul>
        <div class="careers__actions">
          <a class="btn btn--primary" href={applyHref}><Icon name="mail" /> Apply by Email</a>
          <a class="btn btn--ghost" href={site.phone.href}><Icon name="phone" /> Call to Apply</a>
        </div>
      </div>
      <div class="careers__photo">
        <Photo name="careers" variant="rounded" alt="A caregiver helping an older man settle into his chair" />
      </div>
    </div>
  </div>
</section>

<style>
  .careers { padding-top: 0; }
  .careers__card {
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 5vw, 64px); align-items: center;
    background: linear-gradient(135deg, var(--gold-100), #fbf3e4 50%, var(--lilac-100));
    border-radius: 40px; padding: clamp(28px, 5vw, 64px);
  }
  .careers .section-title em { display: block; }
  .checklist { display: grid; gap: 12px; margin-top: 26px; }
  .checklist li { display: flex; align-items: center; gap: 12px; font-weight: 500; }
  .checklist :global(.ic) { width: 26px; height: 26px; padding: 5px; border-radius: 50%; background: var(--plum-700); color: #fff; stroke-width: 3; }
  .careers__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .careers__photo { transform: rotate(2deg); max-width: 380px; width: 100%; justify-self: center; }

  @media (max-width: 980px) {
    .careers__card { grid-template-columns: 1fr; }
    .careers__photo { transform: none; max-width: 340px; }
  }
</style>
