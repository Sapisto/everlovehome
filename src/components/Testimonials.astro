---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";

// Placeholder (sample) reviews are never shown. The section appears once real,
// permission-granted reviews are added without `"placeholder": true`.
const all = (await getCollection("testimonials")).sort((a, b) => a.data.order - b.data.order);
const testimonials = all.filter((t) => !t.data.placeholder);
---

{
  testimonials.length > 0 && (
    <section class="section" id="testimonials">
      <div class="container">
        <header class="head reveal">
          <div>
            <h2 class="section-title">
              Trusted by families. <em>Loved</em> by clients.
            </h2>
          </div>
          <div class="controls">
            <button type="button" class="round-btn" data-dir="-1" aria-label="Previous testimonials">
              <Icon name="left" />
            </button>
            <button type="button" class="round-btn" data-dir="1" aria-label="Next testimonials">
              <Icon name="right" />
            </button>
          </div>
        </header>

        <div class="carousel" tabindex="0" role="region" aria-label="Testimonials" data-carousel>
          {testimonials.map((t) => (
            <figure class="quote">
              <div class="stars" role="img" aria-label={`${t.data.rating} out of 5 stars`}>
                {"★".repeat(t.data.rating)}
              </div>
              <blockquote>"{t.data.quote}"</blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">{t.data.name.charAt(0)}</span>
                <span>
                  <strong>{t.data.name}</strong> {t.data.relation}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  const carousel = document.querySelector<HTMLElement>("[data-carousel]");
  document.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) =>
    btn.addEventListener("click", () => {
      if (!carousel) return;
      const card = carousel.querySelector<HTMLElement>(".quote");
      const step = card ? card.offsetWidth + 24 : carousel.clientWidth;
      const dir = Number(btn.dataset.dir);
      const atEnd = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 4;
      const atStart = carousel.scrollLeft <= 4;
      if (dir > 0 && atEnd) carousel.scrollTo({ left: 0 });
      else if (dir < 0 && atStart) carousel.scrollTo({ left: carousel.scrollWidth });
      else carousel.scrollBy({ left: dir * step });
    }),
  );
</script>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: clamp(32px, 5vw, 48px); }
  .controls { display: flex; gap: 10px; flex-shrink: 0; }
  .round-btn {
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center;
    border: 2px solid var(--lilac-300); background: #fff; color: var(--plum-700);
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .round-btn:hover { background: var(--plum-700); color: #fff; border-color: var(--plum-700); transform: translateY(-2px); }
  .round-btn :global(.ic) { width: 22px; height: 22px; }

  .carousel {
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3); gap: 24px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 8px 4px 24px; margin-inline: -4px; scrollbar-width: none;
  }
  .carousel::-webkit-scrollbar { display: none; }
  .quote {
    margin: 0; scroll-snap-align: start; display: flex; flex-direction: column; gap: 18px; position: relative;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 34px 30px 28px;
    box-shadow: var(--shadow-sm); transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .quote:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .quote::before {
    content: "\201C"; position: absolute; top: -8px; right: 24px;
    font-family: var(--font-display); font-size: 7rem; line-height: 1; color: var(--lilac-200);
  }
  .stars { color: var(--gold); letter-spacing: 3px; font-size: 1.05rem; }
  .quote blockquote { margin: 0; font-family: var(--font-display); font-size: 1.18rem; line-height: 1.5; color: var(--plum-900); flex: 1; position: relative; }
  .quote figcaption { display: flex; align-items: center; gap: 12px; font-size: 0.88rem; color: var(--muted); }
  .quote figcaption strong { display: block; color: var(--ink); font-size: 0.98rem; }
  .quote__avatar {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0;
    font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--orchid), var(--plum-700));
  }

  @media (max-width: 980px) { .carousel { grid-auto-columns: calc((100% - 24px) / 2); } }
  @media (max-width: 640px) {
    .head { flex-direction: column; align-items: flex-start; }
    .carousel { grid-auto-columns: 88%; }
  }
</style>
