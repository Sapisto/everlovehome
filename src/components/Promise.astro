---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import markWhite from "@/assets/brand/logo-mark-white.png";
import { promise } from "@/lib/story";
import { site } from "@/lib/site";
---

<section class="promise" id="promise">
  <Image class="promise__mark" src={markWhite} alt="" aria-hidden="true" width={420} />
  <div class="container promise__inner reveal">
    <div class="promise__copy">
      <p class="script promise__script">our promise</p>
      <p class="promise__belief">{promise.belief}</p>
      <h2>{promise.headline}</h2>
      <p class="promise__text">{promise.text}</p>
      <p class="promise__closing">{promise.closing}</p>
    </div>
    <div class="promise__actions">
      <a class="promise__phone" href={site.phone.href}>
        <span class="promise__phone-icon"><Icon name="phone" /></span>
        <span><small>Talk to our care team</small>{site.phone.display}</span>
      </a>
      <a class="btn btn--gold btn--lg" href="#contact"><Icon name="calendar" /> Schedule a Consultation</a>
    </div>
  </div>
</section>

<style>
  .promise {
    position: relative; overflow: hidden; color: #fff; padding-block: clamp(64px, 9vw, 112px);
    background: linear-gradient(120deg, var(--plum-900), var(--plum-700) 60%, var(--brand));
  }
  .promise :global(.promise__mark) {
    position: absolute; left: -60px; top: 50%; width: 420px; transform: translateY(-50%) rotate(-8deg);
    opacity: 0.08; pointer-events: none;
  }
  .promise__inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: clamp(40px, 6vw, 80px); }
  .promise__copy { max-width: 640px; }
  .promise__script { color: var(--gold-100); font-size: 2.4rem; }
  .promise__belief { color: rgb(255 255 255 / 0.78); margin-top: 10px; }
  .promise h2 {
    font-family: var(--font-display); font-weight: 500; font-size: clamp(1.8rem, 1.3rem + 2vw, 2.7rem);
    letter-spacing: -0.015em; line-height: 1.15; margin-top: 12px; text-wrap: balance;
  }
  .promise__text { color: rgb(255 255 255 / 0.78); margin-top: 16px; }
  .promise__closing { font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--gold-100); margin-top: 16px; }

  .promise__actions { display: grid; gap: 16px; flex-shrink: 0; }
  .promise__phone {
    display: flex; align-items: center; gap: 16px; text-decoration: none; color: #fff;
    font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 600;
    padding: 14px 26px 14px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.2); transition: background 0.25s;
  }
  .promise__phone:hover { background: rgb(255 255 255 / 0.18); }
  .promise__phone small { display: block; font-family: var(--font-body); font-size: 0.78rem; font-weight: 500; color: rgb(255 255 255 / 0.7); letter-spacing: 0.05em; }
  .promise__phone-icon { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--plum-700); flex-shrink: 0; }
  .promise__phone-icon :global(.ic) { width: 26px; height: 26px; }

  @media (max-width: 980px) { .promise__inner { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { .promise__actions, .promise__phone { width: 100%; } }
</style>
