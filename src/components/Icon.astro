---
import type { IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  /** Filled glyph instead of outline. */
  fill?: boolean;
  class?: string;
  /** Accessible label. Omit for decorative icons. */
  label?: string;
}

const { name, fill = false, class: className, label } = Astro.props;
---

<svg
  class:list={["ic", { "ic--fill": fill }, className]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <use href={`#i-${name}`}></use>
</svg>
