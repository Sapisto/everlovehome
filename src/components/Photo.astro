---
/**
 * Photo frame with a branded fallback.
 * Drop a file named `<name>.jpg|jpeg|png|webp` into src/assets/photos/ and it is
 * picked up automatically, optimized and served as responsive WebP.
 */
import { Image } from "astro:assets";
import markWhite from "@/assets/brand/logo-mark-white.png";

interface Props {
  name: "hero" | "about" | "careers";
  alt: string;
  variant?: "arch" | "blob" | "rounded";
  /** Load eagerly (above the fold). */
  priority?: boolean;
}

const { name, alt, variant = "rounded", priority = false } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const match = Object.entries(photos).find(([path]) => path.split("/").pop()?.split(".")[0] === name);
const photo = match?.[1].default;
---

<figure class:list={["photo", `photo--${variant}`]}>
  <Image class="photo__mark" src={markWhite} alt="" aria-hidden="true" width={360} loading={priority ? "eager" : "lazy"} />
  {
    photo && (
      <Image
        class="photo__img"
        src={photo}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 980px) 90vw, 520px"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
    )
  }
</figure>

<style>
  .photo {
    position: relative; margin: 0; overflow: hidden; isolation: isolate; width: 100%;
    background:
      radial-gradient(120% 80% at 20% 0%, rgb(255 255 255 / 0.18), transparent 50%),
      radial-gradient(90% 70% at 100% 100%, rgb(200 150 62 / 0.35), transparent 60%),
      linear-gradient(160deg, var(--orchid) 0%, var(--brand) 40%, var(--plum-900) 100%);
    box-shadow: var(--shadow-lg);
  }
  .photo::before {
    content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0.18;
    background-image: radial-gradient(rgb(255 255 255 / 0.7) 1px, transparent 1.2px);
    background-size: 18px 18px;
  }
  .photo :global(.photo__mark) {
    position: absolute; left: 50%; top: 50%; width: 58%; transform: translate(-50%, -50%);
    opacity: 0.92; filter: drop-shadow(0 20px 40px rgb(28 10 43 / 0.35));
  }
  .photo :global(.photo__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }

  .photo--arch { aspect-ratio: 4 / 5; border-radius: 999px 999px var(--radius-lg) var(--radius-lg); }
  .photo--arch::after {
    content: ""; position: absolute; inset: 14px; border-radius: inherit; z-index: 2; pointer-events: none;
    border: 1.5px solid rgb(255 255 255 / 0.35);
  }
  .photo--blob {
    aspect-ratio: 1; border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
    animation: blob 14s ease-in-out infinite alternate;
  }
  @keyframes blob { to { border-radius: 56% 44% 52% 48% / 44% 56% 44% 56%; } }
  .photo--rounded { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); }
</style>
