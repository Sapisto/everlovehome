---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const items = services.map((s) => (s.id === "respite-care" ? "Respite for Families" : s.data.title));
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[...items, ...items].map((label) => (
      <>
        <span>{label}</span>
        <Icon name="heart" fill />
      </>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--plum-800); color: #fff; overflow: hidden; padding-block: 18px;
    transform: rotate(-1.2deg); margin: -28px -2% 0; position: relative; z-index: 2; box-shadow: var(--shadow);
  }
  .marquee__track { display: flex; align-items: center; gap: 28px; width: max-content; animation: marquee 40s linear infinite; }
  .marquee span { font-family: var(--font-display); font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); font-style: italic; white-space: nowrap; }
  .marquee :global(.ic) { color: var(--gold); width: 18px; height: 18px; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>
