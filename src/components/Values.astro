---
import Icon from "./Icon.astro";
import { mission, values, vision } from "@/lib/story";
---

<section class="section values" id="values">
  <div class="container">
    <div class="pillars">
      <article class="pillar reveal">
        <h2 class="pillar__title">Our Vision</h2>
        <p>{vision}</p>
      </article>
      <article class="pillar reveal">
        <h2 class="pillar__title">Our Mission</h2>
        {mission.map((p) => <p>{p}</p>)}
      </article>
    </div>

    <header class="section-head reveal">
      <h2 class="section-title">Our core values</h2>
    </header>
    <ul class="value-grid">
      {values.map((v) => (
        <li class="value reveal">
          <span class="value__icon"><Icon name={v.icon} /></span>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values { background: #fff; }
  .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: clamp(64px, 9vw, 104px); }
  .pillar {
    display: grid; align-content: start; gap: 14px; padding: clamp(26px, 4vw, 40px);
    border-radius: var(--radius-lg); background: var(--lilac-50); border: 1px solid var(--line);
  }
  .pillar__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); color: var(--plum-900); }
  .pillar p { color: var(--muted); }

  .value-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px 28px; }
  .value { display: grid; align-content: start; gap: 8px; }
  .value__icon {
    width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px; margin-bottom: 6px;
    background: var(--lilac-100); color: var(--brand);
  }
  .value__icon :global(.ic) { width: 22px; height: 22px; }
  .value h3 { font-size: 1.08rem; font-weight: 700; color: var(--plum-900); }
  .value p { font-size: 0.96rem; color: var(--muted); }

  @media (max-width: 980px) {
    .pillars { grid-template-columns: 1fr; }
    .value-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) { .value-grid { grid-template-columns: 1fr; } }
</style>
