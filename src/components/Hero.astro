---
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { site } from "@/lib/site";
---

<section class="hero">
  <svg class="hero__heart-bg" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-heart"></use></svg>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="script hero__script reveal">{site.tagline}</p>
      <h1 class="hero__title reveal">Care that feels like <em>family</em>, right&nbsp;at&nbsp;home.</h1>
      <p class="hero__lead reveal">
        Trusted, personalized in-home care that helps the people you love stay safe, comfortable and independent, in the
        place they love most.
      </p>
      <div class="hero__actions reveal">
        <a class="btn btn--primary btn--lg" href="#contact"><Icon name="calendar" /> Book a Free Consultation</a>
        <a class="btn btn--ghost btn--lg" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
      </div>
      <ul class="hero__trust reveal" aria-label="Why families choose us">
        <li><Icon name="shield" /> Background-checked caregivers</li>
        <li><Icon name="clock" /> Hourly to around-the-clock</li>
        <li><Icon name="clipboard" /> Personalized care plans</li>
      </ul>
    </div>

    <div class="hero__visual reveal">
      <Photo name="hero" variant="arch" priority alt="An EverLove caregiver sharing a warm moment with a client at home" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(72px, 9vw, 120px);
    background:
      radial-gradient(900px 600px at 85% 10%, rgb(154 79 200 / 0.16), transparent 60%),
      radial-gradient(700px 500px at 0% 100%, rgb(200 150 62 / 0.1), transparent 60%),
      var(--cream);
  }
  .hero__heart-bg {
    position: absolute; width: 900px; height: 900px; right: -260px; top: -120px; pointer-events: none;
    fill: none; stroke: rgb(107 31 147 / 0.07); stroke-width: 0.35;
  }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(40px, 6vw, 80px); align-items: center; position: relative; }
  .hero__script { font-size: clamp(2rem, 1.6rem + 1.6vw, 2.9rem); margin-bottom: 8px; color: var(--orchid); }
  .hero__title {
    font-family: var(--font-display); font-weight: 500; font-optical-sizing: auto;
    font-size: clamp(2.7rem, 1.6rem + 4.4vw, 5rem); letter-spacing: -0.025em; line-height: 1.02;
    color: var(--plum-900); text-wrap: balance;
  }
  .hero__title em { position: relative; font-style: italic; color: var(--brand); font-weight: 450; white-space: nowrap; z-index: 0; }
  .hero__title em::after {
    content: ""; position: absolute; left: 2%; right: 2%; bottom: 0.02em; height: 0.14em; z-index: -1;
    background: linear-gradient(90deg, var(--gold), #e5c07a); border-radius: 99px; opacity: 0.55;
    transform-origin: left; animation: underline 1.2s 0.6s var(--ease) both;
  }
  @keyframes underline { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hero__lead { font-size: clamp(1.08rem, 1rem + 0.4vw, 1.28rem); color: var(--muted); margin-top: 24px; max-width: 34em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .hero__trust { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 36px; color: var(--plum-800); font-weight: 600; font-size: 0.93rem; }
  .hero__trust li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__trust :global(.ic) { color: var(--gold-600); width: 20px; height: 20px; }

  .hero__visual { position: relative; max-width: 520px; justify-self: end; width: 100%; }

  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { justify-self: center; max-width: 440px; margin-top: 12px; }
  }
  @media (max-width: 640px) {
    .hero__actions .btn { width: 100%; }
    .hero__trust { flex-direction: column; gap: 10px; }
  }
</style>
